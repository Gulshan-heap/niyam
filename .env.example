# Copy to .env. Defaults work with `docker compose up db` + running the API locally.
NIYAM_DATABASE_URL=postgresql+psycopg://niyam:niyam@localhost:5432/niyam
NIYAM_LOG_LEVEL=INFO
# Daily ingestion worker (India time); set INGEST_ON_START=false to skip the start-up run.
NIYAM_INGEST_HOUR=20
NIYAM_INGEST_ON_START=true
# Answer generation (LiteLLM). Set the key for your provider; models without a key are skipped.
GROQ_API_KEY=
# GEMINI_API_KEY=
# NIYAM_LLM_MODEL=groq/openai/gpt-oss-120b
# Telegram bot and daily change alerts (token from @BotFather); both stay off without it.
# TELEGRAM_BOT_TOKEN=
# Optional LLM tracing (https://langfuse.com): `uv add langfuse` and set both keys.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com

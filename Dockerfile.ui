FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy PATH="/app/.venv/bin:$PATH"
WORKDIR /app

# Only the UI's own dependencies (flask, gunicorn, httpx); it talks to the API over HTTP.
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --only-group ui --no-install-project

COPY ui ./ui

EXPOSE 8501
# /ask can take a while (LLM calls), so the worker timeout is generous.
CMD ["gunicorn", "--chdir", "ui", "--bind", "0.0.0.0:8501", "--workers", "2", "--timeout", "150", "app:app"]
